# Скопируйте этот файл в .env и заполните перед запуском на боевом сервере

# Секретный ключ для подписи токенов входа (JWT).
# Сгенерировать случайный: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Пароль администратора, который создаётся автоматически при первом запуске
# (логин по умолчанию: Саидислом). После первого входа смените его в разделе
# "Настройки цен" -> "Моя учётная запись".
ADMIN_PASSWORD=12345678

# Порт, на котором будет работать сервер
PORT=3000
